# ---------------------------------------------------------------------------------------------------------------
# All environment-specific configuration (D4). Copy to .env to override. docker-compose.yml reads this file first and
# then .env (if present), so a clean clone works with no edits. Never commit .env.
# ---------------------------------------------------------------------------------------------------------------

# --- infrastructure endpoints (docker compose service names) ---
REDIS_URL=redis://redis:6379/0
LLM_BASE_URL=http://llm-gateway:8080
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
INDEX_DIR=/data/index
CORPUS_DIR=/app/corpus

# --- model provider (behind llm-gateway) ---
# heuristic = deterministic offline provider (no key, used for dev, tests, eval and the D6 load-test stub)
# openai_compat = any OpenAI-compatible endpoint (e.g. a free tier). Set the three values below in .env, not here.
GATEWAY_PROVIDER=heuristic
GATEWAY_UPSTREAM_URL=
LLM_MODEL=
LLM_API_KEY=
GATEWAY_LATENCY_MS=400
GATEWAY_LATENCY_JITTER_MS=150

# --- embeddings: hashing works offline; for sentence-transformers set EMBEDDING_BACKEND=sentence-transformers,
#     EMBEDDING_MODEL=<model name, e.g. a MiniLM variant>, and build with INSTALL_ST=1
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=

# --- agent loop limits (A1) ---
AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_WALL_S=25
TOOL_TIMEOUT_S=5
MAX_VERIFY_RETRIES=1
RUN_DEADLINE_S=120
SEARCH_STRATEGY=agentic

# --- prompt versions (L2) ---
PROMPT_CLASSIFY=v1
PROMPT_RESEARCH_PLAN=v1
PROMPT_DRAFT_POSITION=v2

# --- resilience (A5) ---
LLM_TIMEOUT_S=10
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.3
BREAKER_FAILURE_THRESHOLD=4
BREAKER_OPEN_S=15

# --- queue / workers ---
WORKER_THREADS=4
QUEUE_CLAIM_IDLE_S=45
QUEUE_MAX_DELIVERIES=3

# --- cost accounting: reference USD rates per 1k tokens (L5). Free tier = $0 billed; these price the budget.
PRICE_PROMPT_PER_1K=0.00015
PRICE_COMPLETION_PER_1K=0.0006

# --- caching / rate limiting (D7) ---
RUN_CACHE_ENABLED=true
RUN_CACHE_TTL_S=3600
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_RUNS_PER_HOUR=600

# --- live quality sampling (L6) ---
LIVE_SCORE_SAMPLE_RATE=0.25
LOG_LEVEL=INFO

# --- grafana admin (local only) ---
GF_SECURITY_ADMIN_PASSWORD=change-me
